# Anthropic
ANTHROPIC_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_1=
ELEVENLABS_VOICE_ID_2=
ELEVENLABS_VOICE_ID_3=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for scripts/run-migration.ts (applying a migration from the CLI
# instead of the Supabase Dashboard SQL editor). Not needed to run the app.
SUPABASE_ACCESS_TOKEN=

# OpenAI — server-side only. Used by: the Notes Coach (gpt-4o vision), the
# Realtime "Prove Your Mastery" coach (below), and the local architecture
# dashboard admin assistant. Never expose this key via a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
HUGH_ADMIN_URL=http://localhost:3000/admin

# Realtime "Prove Your Mastery" coach — feature flag. When "true", the mastery
# session at /mastery/[milestoneId] runs a live OpenAI Realtime speech-to-speech
# conversation (mic, auto turn-taking, dynamic follow-ups) instead of the scripted
# ElevenLabs + Web Speech flow. `?classic=1` forces the scripted flow. Requires
# OPENAI_API_KEY. When unset/"false", the original scripted flow is used.
MASTERY_REALTIME_ENABLED=false

# Course-from-document upload — feature flag, OFF by default. When "true", the
# /home/learn panel offers "Upload a document" and the two document routes
# accept requests. Locked on 2026-09-09 pending an answer to what happens when a
# learner uploads material they did not mean to send; the prompt-injection
# defence around it is unchanged and still in the code. Opt-in on purpose: a
# flag that defaults to on turns itself on wherever nobody configured it.
DOCUMENT_UPLOAD_ENABLED=false

# Local model provider (Ollama) - optional, and only used by models whose id
# is prefixed "ollama/". Hugh talks to it through Ollama's OpenAI-compatible
# endpoint, so no key is involved and nothing is billed. Unset means the
# default below; set it when the daemon runs on another machine.
#
# Nothing calls a local model unless a model id explicitly asks for one, so
# leaving this blank changes no behaviour.
OLLAMA_BASE_URL=http://localhost:11434/v1
